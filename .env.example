# SplitWise Pro — Environment Variables Template
# Copy this to .env and fill in real values for local dev
# For Render: set these directly in the Render Dashboard > Environment

# ── Database ─────────────────────────────────────────────────────────
# LOCAL (SQL Server):
# ConnectionStrings__DefaultConnection=Server=(localdb)\mssqllocaldb;Database=SplitWiseProDb;Trusted_Connection=True;TrustServerCertificate=True
# USE_SQL_SERVER=true

# PRODUCTION (PostgreSQL from Render):
ConnectionStrings__DefaultConnection=Host=your-pg-host;Port=5432;Database=splitwisepro;Username=splitwisepro_user;Password=your-pg-password

# ── JWT ──────────────────────────────────────────────────────────────
# Generate a secure key: openssl rand -base64 32
JwtSettings__SecretKey=CHANGE_THIS_TO_A_SECURE_256_BIT_KEY_MIN_32_CHARS_1234567890ABCDEF
JwtSettings__Issuer=SplitWisePro.API
JwtSettings__Audience=SplitWisePro.Client
JwtSettings__AccessTokenExpirationMinutes=30
JwtSettings__RefreshTokenExpirationDays=7

# ── Email / Brevo SMTP ───────────────────────────────────────────────
# Sign up free at: https://brevo.com → SMTP & API → SMTP tab → Generate SMTP key
Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=587
Email__FromName=SplitWise Pro
Email__From=noreply@yourdomain.com
Email__Username=your-brevo-login@email.com
Email__Password=your-brevo-smtp-api-key

# ── CORS ─────────────────────────────────────────────────────────────
# Add your Vercel frontend URL here after deploying
Cors__AllowedOrigins__0=https://your-app.vercel.app
Cors__AllowedOrigins__1=http://localhost:4200

# ── ASP.NET Core ─────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:10000
